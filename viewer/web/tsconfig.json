{
  // src/*.ts is what is written; js/*.js is what the browser gets (and what is committed).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    // A field declaration emits nothing of its own, so the JS below js/ does what the TS says
    // and in the same order. tsc lays the code out its own way; the browser is given the
    // sourcemap (with the TS inside it), so what is stepped through is what was written.
    "useDefineForClassFields": false,
    "rootDir": "src",
    "outDir": "js",
    "sourceMap": true,
    "inlineSources": true,
    "newLine": "lf",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
