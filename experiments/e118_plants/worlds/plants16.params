# plants16: plants at metres on the map at an animal's size (#135 rung 2, e118). Read after base/worlds/isles1.params
# and base/worlds/isles16.params (the ground, the air and the water are theirs); a line here says what the living need.
fine=25          # the ground at 5 m, drawn at the sowing from the bare years' rain: the field's cells
sow=10           # ten bare years first (the sea's warmth settles in four)
life_every=37    # a plant step is 5 days (37 updates): a step a day took 150 s a year for 1.4 million cells
seed_every=6     # seeds leave monthly (the base's 15 daily steps was every 16 days)
steep=1.2        # soil up to 50 degrees: the 5 m ground is rough, at 40 degrees a quarter of the land was cliff
