# isles16: the map at an animal's size (#135, e117) - 16 km on a side, cells of 125 m, a fifth of it land (40-60 km2)
# in about four islands. The laws and rates are isles1's (base/worlds/isles1.params, read first); a line here says
# what differs and why.
size=128
cell_km=0.125
land=0.2         # 51 km2 of 256
edge=16          # the last 2 km before the border sink under the sea
grain=48         # 6 km: islands a few km across
relief=1500      # one high island with a snow line (1,800 m made a 22 km2 island a slope of 35 degrees on average)
lat_span=1       # a band of latitude folded north to south: the one stated fiction (#135)
lat_lo=44         # lowlands about 19 C mean in the south and 7 C in the north (e117's trials: 42-62 gave 20.5 and 9.0)
lat_hi=64
year=27266       # 365 days of 74.7 steps: a real year (#135); isles1's update of 3.2 hours is kept
wind_dir=10      # the westerlies: from the west-south-west, blowing east-north-east
wind_turn=20
storm_radius=8   # 1 km (isles1: 10 cells of 125 m)
seed=23          # of forty surveyed: 21.9 km2 to 1,500 m, 12.4, 9.2 and 4.4 km2, two islets
mirror=1         # the high island's summit on its west coast: its lowlands lie in the lee (unmirrored they lay to windward of it, the lee was sea)
wind_sd=25       # the westerlies wander less than isles1's trade wind (45): a lee stays a lee
# the year's water (e117): fronts from a storm track whose edge lies at 48 N, 8 degrees further north at midsummer and
# south at midwinter (the crate's defaults: a front of 1.5 days, 2.5 clear days between, the clear air 0.2 short)
track=900        # mm a year where every front reaches: the north's lowlands 1,200 mm, the south's 650 with a rainless summer
rain_tau=200     # s: these islands' slopes are crossed in 200-400 s; at isles1's 1,000 s the rain fell alike on both sides of a summit
lifted=0.012     # with rain_tau 200: 2-3.3 m a year on the windward heights (isles1's 0.05 at 1,000 s rained 5-10 m)
snow_melt=3      # mm a day a degree: the north's lowlands lie under snow four months, the summits five
relief_pow=1.8    # lowlands flat and one summit: the noise's heights scaled alike made every island a mountain (50 degrees at 60 m)
