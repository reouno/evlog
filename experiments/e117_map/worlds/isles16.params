# isles16: the map at an animal's size (#135, e117) - 16 km on a side, cells of 125 m, a fifth of it land (40-60 km2)
# in about four islands. The laws and rates are isles1's (base/worlds/isles1.params, read first); a line here says
# what differs and why.
size=128
cell_km=0.125
land=0.2         # 51 km2 of 256
edge=16          # the last 2 km before the border sink under the sea
grain=48         # 6 km: islands a few km across
relief=1500      # one high island with a snow line (1,800 m made a 22 km2 island a slope of 35 degrees on average)
lat_span=1       # a band of latitude folded north to south: the one stated fiction (#135)
lat_lo=44         # lowlands about 19 C mean in the south and 7 C in the north (e117's trials: 42-62 gave 20.5 and 9.0)
lat_hi=64
year=27266       # 365 days of 74.7 steps: a real year (#135); isles1's update of 3.2 hours is kept
wind_dir=10      # the westerlies: from the west-south-west, blowing east-north-east
wind_turn=20
storm_radius=8   # 1 km (isles1: 10 cells of 125 m)
seed=23          # of forty surveyed: 21.9 km2 to 1,800 m, 12.4, 9.2 and 4.4 km2, two islets
lifted=0.02      # isles1's 0.05 rained 5-10 m a year on the heights over a year of 365 days; 0.02 gives 2-3.3 m
