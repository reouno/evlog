# isles1: the small world (#126, e108) - 64 km on a side, cells of 125 m, a tenth of it land: 410 km2 in eight
# islands, five of them over 20 km2 (964 to 2,002 m high). The laws and rates are c1225's (c1225.params); a line
# that differs from it says why. The living cross metres (e109), so their rates need no line here.
size=512
seed=1           # of sixteen: the one with five islands over 20 km2
year=11880
day=74.7
tick=10
cell_km=0.125
land=0.10        # a tenth of the world is land (#126): 400-500 km2
edge=96          # the last 12 km before the border sink under the sea: the world is land in a sea, it does not wrap
relief=2002
grain=158.7      # 20 km here: the widest feature of the ground, so islands some 10-20 km across
rough=0.5
lat_lo=42        # one latitude: under e061's sun an open sea settles near 21 C there, and the year's light swings 2x
lat_hi=42
span_lon=0       # 64 km is one hour
aspect=1         # at 125 m a slope faces the sun or away from it
tilt=17.8
night=-30
gain=219.6
lapse=6.5
land_rate=0.2854
sea_rate=0.0005
spread=0.2
sweep=1          # the wind crosses the world in 3.2 hours, an update: the air is followed across it, not shifted a cell
wind_ms=5.5      # c1225's 1 cell of 63 km an update
wind_dir=200     # it blows to the west-south-west: a north-easterly, as a trade wind is
wind_turn=35.8
wind_bands=0     # one latitude has one band
soil=150
deposit=0.0025   # of a river's load dropped a cell of flat land: 2% a km (c1225's 0.02 was a cell of 63 km)
sea_mix=0.8      # the sea mixes across a 125 m edge as fast as the scheme allows
river_q=74       # mm an update out of a cell of 125 m is 0.1 m3/s, a stream that runs all year
storms=0.0144    # a year: on c1225 a cell lay under one of its 12 storms about once in 70 years
